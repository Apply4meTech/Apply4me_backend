MONGODB_URI= "connection string written in jira https://tech2026.atlassian.net/browse/KAN-2?focusedCommentId=10000 "
JWT_SECRET=somestring
JWT_EXPIRES_IN=30d

# Dev/Test: Enable fake payment for testing full flow without Stripe (set to true to enable)
# ENABLE_DEV_FAKE_PAYMENT=true

# 100% off coupon code (seed with: node scripts/seedCoupon.js)
# COUPON_CODE=APPLY100

# -----------------------------------------------------------------------------
# ZeptoMail (HTTP API only) — https://zeptomail.zoho.in
# Mail Agents → your agent → SMTP/API → copy "Send Mail Token" into ZEPTOMAIL_API_TOKEN
# India: https://api.zeptomail.in/v1.1/email  |  Other regions may use api.zeptomail.com
# npm run verify:zeptomail   (optional: VERIFY_EMAIL_TO=you@example.com)
# -----------------------------------------------------------------------------
ZEPTOMAIL_API_URL=https://api.zeptomail.in/v1.1/email
ZEPTOMAIL_API_TOKEN=YOUR_ZEPTOMAIL_SEND_MAIL_TOKEN
EMAIL_FROM=contactus@applyforme.com.au
SENDER_NAME="Apply For Me"
SENDER_EMAIL=contactus@applyforme.com.au
EMAIL_SITE_NAME="Apply For Me"
SUPPORT_EMAIL=contactus@applyforme.com.au

# Comma-separated — notified when a new customer signs up (defaults to internal team list in code)
# NEW_CUSTOMER_NOTIFY_EMAILS=sneha.naidu95@gmail.com,aryan.singla@applyforme.com.au,ojus.madan@applyforme.com.au,ayushsingla21.dev@gmail.com

# Optional: legacy alias — if set, used when ZEPTOMAIL_API_TOKEN is empty
# SMTP_PASS=

# Test email API (POST /api/test/emails/send) — disabled in production unless ENABLE_TEST_EMAIL=true
# ENABLE_TEST_EMAIL=true
# TEST_EMAIL_SECRET=your-random-secret

# -----------------------------------------------------------------------------
# Job scraper (employee Job Finder)
# Recommended: Adzuna — https://developer.adzuna.com/
# -----------------------------------------------------------------------------
JOB_SCRAPER_PROVIDER=adzuna
ADZUNA_APP_ID=your-adzuna-app-id
ADZUNA_APP_KEY=your-adzuna-app-key
JOB_SCRAPER_COUNTRY=au

# Alternative: JSearch (RapidAPI) — https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
# JOB_SCRAPER_PROVIDER=jsearch
# JSEARCH_RAPIDAPI_KEY=your-rapidapi-key
# JSEARCH_RAPIDAPI_HOST=jsearch.p.rapidapi.com
# JSEARCH_RAPIDAPI_PATH=/search-v2
# JOB_SCRAPER_DEFAULT_LOCATION=Sydney
# JOB_SCRAPER_FALLBACK_MOCK=true
